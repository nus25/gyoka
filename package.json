{
  "name": "gyoka",
  "version": "0.9.3",
  "private": "true",
  "description": "simple feed generator for bluesky which works on cloudflare workers",
  "license": "MIT",
  "author": "Nus",
  "scripts": {
    "editor": "pnpm -F gyoka-editor",
    "generator": "pnpm -F gyoka-generator",
    "shared": "pnpm -F shared",
    "d1-create": "wrangler d1 create gyoka-db --binding=DB",
    "d1-init:local": "pnpm editor d1-init:local",
    "d1-init:production": "pnpm editor d1-init:production",
    "d1-add-sample:local": "pnpm editor d1-add-sample:local",
    "test:all": "pnpm -r test run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware"
  },
  "devDependencies": {
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.15.1"
}
