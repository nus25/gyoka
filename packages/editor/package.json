{
  "name": "gyoka-editor",
  "version": "1.0.0",
  "private": "true",
  "license": "MIT",
  "author": "Nus",
  "type": "module",
  "scripts": {
    "postinstall": "node ../shared/scripts/copy-config.js",
    "dev": "CLOUDFLARE_ENV=dev vite dev",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "CLOUDFLARE_ENV=production vite build && echo VERSION=$(node -p \"require('./package.json').version\") GIT_SHA=$(git rev-parse --short HEAD) && wrangler deploy --tag ver:$(node -p \"require('./package.json').version\") --message GIT_SHA:$(git rev-parse --short HEAD)",
    "generate": "pnpm run generate:lexicons && pnpm run cf-typegen",
    "generate:lexicons": "lex-cli generate --config lex.config.js",
    "cf-typegen": "wrangler types --strict-vars=false --env production",
    "d1-migrate:local": "wrangler d1 migrations apply DB --local --persist-to=../../data --env=dev",
    "d1-migrate:production": "wrangler d1 migrations apply DB --remote --env=production",
    "d1-add-dummy:local": "wrangler d1 execute DB --local --file=../shared/dummy/dummy_data.sql --persist-to=../../data --env=dev"
  },
  "dependencies": {
    "@atcute/identity": "catalog:",
    "@atcute/identity-resolver": "catalog:",
    "@atcute/lexicons": "catalog:",
    "@atcute/xrpc-server": "catalog:",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@atcute/cid": "catalog:",
    "@atcute/crypto": "catalog:",
    "@atcute/lex-cli": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "wrangler": "catalog:"
  },
  "atcute:lexicons": {
    "mappings": {
      "net.nusno.gyoka.*": {
        "type": "namespace",
        "path": "./src/lexicons/{{nsid_remainder}}"
      }
    }
  }
}
