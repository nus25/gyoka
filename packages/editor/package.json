{
  "name": "gyoka-editor",
  "version": "0.8.0",
  "license": "MIT",
  "author": "Nus",
  "scripts": {
    "postinstall": "node ../shared/scripts/copy-config.js",
    "deploy": "echo VERSION=$(node -p \"require('./package.json').version\") GIT_SHA=$(git rev-parse --short HEAD) && wrangler deploy --env production --var VERSION:$(node -p \"require('./package.json').version\") --var GIT_SHA:$(git rev-parse --short HEAD)",
    "dev": "wrangler dev --persist-to=../../data --env dev",
    "cf-typegen": "wrangler types --strict-vars=false --env production",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "d1-init:local": "wrangler d1 execute gyoka-db --local --file=../shared/migrations/0000_initial.sql --persist-to=../../data --env=dev",
    "d1-init:production": "wrangler d1 execute gyoka-db --remote --file=../shared/migrations/0000_initial.sql --env=production",
    "d1-add-sample:local": "wrangler d1 execute gyoka-db --local --file=../shared/migrations/0001_dummydata.sql --persist-to=../../data --env=dev"
  },
  "dependencies": {
    "chanfana": "3.0.0",
    "hono": "^4.12.5",
    "shared": "workspace:*",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^22.15.35",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@10.28.2"
}
