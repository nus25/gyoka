{
    "name": "gyoka-editor",
    "version": "0.7.0",
    "scripts": {
        "postinstall": "node ../shared/scripts/copy-config.js",
        "deploy": "echo VERSION=$(node -p \"require('./package.json').version\") GIT_SHA=$(git rev-parse --short HEAD) && wrangler deploy --env production --var VERSION:$(node -p \"require('./package.json').version\") --var GIT_SHA:$(git rev-parse --short HEAD)",
        "dev": "wrangler dev --persist-to=../../data --env dev",
        "cf-typegen": "wrangler types --strict-vars=false --env production",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "d1-init-local": "wrangler d1 execute gyoka-db --local --file=../shared/migrations/0000_initial.sql --persist-to=../../data --env=dev",
        "d1-add-dummy-local": "wrangler d1 execute gyoka-db --local --file=../shared/migrations/0001_dummydata.sql --persist-to=../../data --env=dev"
    },
    "dependencies": {
        "chanfana": "^2.8.3",
         "hono": "^4.11.4",
        "zod": "^3.24.4",
        "shared": "workspace:*"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.8.49",
        "@cloudflare/workers-types": "^4.20260111.0",
        "@types/node": "^22.15.35",
        "@types/service-worker-mock": "^2.0.4",
        "wrangler": "4.59.1"
    },
    "packageManager": "pnpm@10.25.0",
    "author": "Nus",
    "license": "MIT"
}