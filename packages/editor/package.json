{
  "name": "gyoka-editor",
  "version": "0.9.1",
  "license": "MIT",
  "author": "Nus",
  "scripts": {
    "postinstall": "node ../shared/scripts/copy-config.js && node ../shared/scripts/create-dev-vars.js",
    "deploy": "echo VERSION=$(node -p \"require('./package.json').version\") GIT_SHA=$(git rev-parse --short HEAD) && wrangler deploy --env production --tag ver:$(node -p \"require('./package.json').version\") --message GIT_SHA:$(git rev-parse --short HEAD)",
    "dev": "wrangler dev --persist-to=../../data --env dev",
    "cf-typegen": "wrangler types --strict-vars=false --env production",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "d1-init:local": "wrangler d1 execute gyoka-db --local --file=../shared/migrations/0000_initial.sql --persist-to=../../data --env=dev",
    "d1-init:production": "wrangler d1 execute gyoka-db --remote --file=../shared/migrations/0000_initial.sql --env=production",
    "d1-add-sample:local": "wrangler d1 execute gyoka-db --local --file=../shared/migrations/0001_dummydata.sql --persist-to=../../data --env=dev",
    "gyoka-api-key:put": "wrangler versions secret put GYOKA_API_KEY --env production"
  },
  "dependencies": {
    "chanfana": "3.0.0",
    "hono": "catalog:",
    "shared": "workspace:*",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@10.30.3"
}
