{
  "name": "gyoka-generator",
  "version": "0.10.0",
  "license": "MIT",
  "author": "Nus",
  "scripts": {
    "postinstall": "node ../shared/scripts/copy-config.js",
    "deploy": "echo VERSION=$(node -p \"require('./package.json').version\") GIT_SHA=$(git rev-parse --short HEAD) && wrangler deploy --env production --tag ver:$(node -p \"require('./package.json').version\") --message GIT_SHA:$(git rev-parse --short HEAD)",
    "dev": "wrangler dev --persist-to=../../data --env dev",
    "cf-typegen": "wrangler types --strict-vars=false --env production",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@atcute/atproto": "4.0.4",
    "@atcute/bluesky": "4.0.17",
    "@atcute/identity": "2.0.2",
    "@atcute/identity-resolver": "2.0.1",
    "@atcute/lexicons": "2.0.3",
    "@atcute/xrpc-server": "2.0.2",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@atcute/crypto": "^2.4.4",
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "wrangler": "catalog:"
  }
}
