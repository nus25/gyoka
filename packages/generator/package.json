{
  "name": "gyoka-generator",
  "version": "0.8.0",
  "scripts": {
    "postinstall": "node ../shared/scripts/copy-config.js",
    "deploy": "echo VERSION=$(node -p \"require('./package.json').version\") GIT_SHA=$(git rev-parse --short HEAD) && wrangler deploy --env production --var VERSION:$(node -p \"require('./package.json').version\") --var GIT_SHA:$(git rev-parse --short HEAD)",
    "dev": "wrangler dev --persist-to=../../data --env dev",
    "cf-typegen": "wrangler types --strict-vars=false --env production",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "shared": "workspace:*",
    "@atcute/atproto": "^3.1.10",
    "@atcute/bluesky": "^3.2.17",
    "@atcute/identity": "^1.1.3",
    "@atcute/identity-resolver": "^1.2.2",
    "@atcute/lexicons": "^1.2.9",
    "@atcute/xrpc-server": "^0.1.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^22.15.35",
    "wrangler": "catalog:",
    "@atcute/crypto": "^2.3.0"
  },
  "packageManager": "pnpm@10.28.2",
  "author": "Nus",
  "license": "MIT"
}
