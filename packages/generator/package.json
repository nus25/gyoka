{
  "name": "gyoka-generator",
  "version": "0.8.0",
  "scripts": {
    "postinstall": "node ../shared/scripts/copy-config.js",
    "deploy": "echo VERSION=$(node -p \"require('./package.json').version\") GIT_SHA=$(git rev-parse --short HEAD) && wrangler deploy --env production --var VERSION:$(node -p \"require('./package.json').version\") --var GIT_SHA:$(git rev-parse --short HEAD)",
    "dev": "wrangler dev --persist-to=../../data --env dev",
    "cf-typegen": "wrangler types --strict-vars=false --env production",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "shared": "workspace:*",
    "@atcute/atproto": "^3.0.3",
    "@atcute/bluesky": "^3.0.4",
    "@atcute/identity": "^1.0.2",
    "@atcute/identity-resolver": "^1.1.3",
    "@atcute/lexicons": "^1.0.4",
    "@atcute/xrpc-server": "^0.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.7",
    "@cloudflare/workers-types": "4.20260124.0",
    "@types/node": "^22.15.35",
    "@types/service-worker-mock": "^2.0.4",
    "wrangler": "4.61.0"
  },
  "packageManager": "pnpm@10.28.2",
  "author": "Nus",
  "license": "MIT"
}
