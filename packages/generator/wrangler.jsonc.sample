/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gyoka-generator",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-05",
  "minify": true,
  "env": {
    "test": {
      "define": {
        /* Build-time flag: false disables /docs, /redocs, /openapi.json route registration. */
        "__OPENAPI_DOCS_ENABLED__": "false"
      },
      "vars": {
        "FEEDGEN_AUTH_REQUIRED": "disabled",
        "DID_CACHE_TTL_SECONDS": "86400"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gyoka-db",
          "database_id": "test_id"
        }
      ]
    },
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gyoka-db",
          "database_id": "dev_id"
        }
      ],
      /**
       * Environment Variables
       * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
       */
      "define": {
        /* Build-time flag: set true for local debugging of docs and schema endpoints. */
        "__OPENAPI_DOCS_ENABLED__": "true"
      },
      "vars": {
        "FEEDGEN_PUBLISHER_DID": "did:example:developer",
        "FEEDGEN_HOST": "dev.example.com",
        "FEEDGEN_AUTH_REQUIRED": "disabled",
        "DID_CACHE_TTL_SECONDS": "86400",
        "DEVELOPER_MODE": "enabled"
      }
    },
    "production": {
      // "routes": [
      // 	{
      // 		"pattern": "feed-generator.example.com",
      // 		"custom_domain": true
      // 	}
      // ],
      "preview_urls": false,
      "workers_dev": true, // false for custom_domain
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1.0
      },
      "define": {
        /* Build-time flag: keep false in production for best runtime performance. */
        "__OPENAPI_DOCS_ENABLED__": "false"
      },
      "vars": {
        /* DID of your Bluesky account or alternative publisher */
        "FEEDGEN_PUBLISHER_DID": "did:example:publisher",
        /* deployed worker host accessed from AppView */
        "FEEDGEN_HOST": "feed-generator.example.com",
        /* Runtime flag: enable service JWT authentication for XRPC endpoints when set to "enabled". */
        "FEEDGEN_AUTH_REQUIRED": "enabled",
        /* DID resolver cache TTL in seconds. 86400 = 1 day. */
        "DID_CACHE_TTL_SECONDS": "86400",
        /* Runtime flag: enables verbose debug logging in endpoints when set to "enabled". */
        "DEVELOPER_MODE": "disabled",
        /* Version from package.json (overridden by --var during deploy) */
        "VERSION": "0.0.0",
        /* Git commit hash (overridden by --var during deploy) */
        "GIT_SHA": "unknown"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gyoka-db",
          "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
        }
      ]
    }
  }
}
